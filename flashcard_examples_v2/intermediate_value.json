  "concept": "Intermediate Value Theorem",
  "source": {
    "book_tag": "openstax_calc1",
    "section": "2.4",
    "lo_ordinal": 5,
    "lo_text": "Provide an example of the intermediate value theorem."
  },
  "front": {
    "title": "Intermediate Value",
    "subtitle": "No Skipped Values",
    "central": {
      "text": "A continuous function takes every value between its two endpoint values."
    },
    "main_description": "An unbroken graph must hit every height in between.",
    "supporting_description": "If the curve starts below a target and ends above it, it crossed.",
    "footer": "Flip for a worked example"
  },
  "back": {
    "title": "Worked Example",
    "problem": [
      {
        "t": "text",
        "v": "Does "
      },
      {
        "t": "math",
        "latex": "f(x)=x^{3}-4x+1"
      },
      {
        "t": "text",
        "v": "have a root between 1 and 4?"
      }
    ],
    "rows": [
      {
        "segments": [
          {
            "t": "text",
            "v": "Every polynomial is continuous, so this one has no breaks."
          }
        ],
        "aligned": false,
        "bold": false
      },
      {
        "segments": [
          {
            "t": "text",
            "v": "At the left endpoint"
          },
          {
            "t": "math",
            "latex": "f(1)=-2"
          }
        ],
        "aligned": false,
        "bold": false
      },
      {
        "segments": [
          {
            "t": "text",
            "v": "At the right endpoint"
          },
          {
            "t": "math",
            "latex": "f(4)=49"
          }
        ],
        "aligned": false,
        "bold": false
      },
      {
        "segments": [
          {
            "t": "text",
            "v": "The output goes from negative to positive."
          }
        ],
        "aligned": false,
        "bold": false
      },
      {
        "segments": [
          {
            "t": "text",
            "v": "So a root is guaranteed between 1 and 4."
          }
        ],
        "aligned": false,
        "bold": true
      }
    ],
    "footer": "Endpoints with opposite signs guarantee a root between them."
  }
}
